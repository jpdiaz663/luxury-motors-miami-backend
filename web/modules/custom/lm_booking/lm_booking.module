<?php

/**
 * @file
 * Views integration and checkout theme hooks.
 */

declare(strict_types=1);

/**
 * Implements hook_views_data_alter().
 */
function lm_booking_views_data_alter(array &$data): void {
  $data['node_field_data']['lm_booking_available_window'] = [
    'title' => t('Available in rental window'),
    'help' => t('Hides vehicles that have a pending, confirmed, or picked-up booking overlapping pickup/return. Completed and cancelled bookings do not block.'),
    'filter' => [
      'id' => 'lm_booking_available_window',
    ],
  ];
}

