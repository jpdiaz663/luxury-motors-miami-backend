/**
 * Implements hook_preprocess_HOOK() for confirmation itinerary.
 */
function lm_booking_preprocess_lm_booking_confirmation(array &$variables): void {
  $path = \Drupal::service('extension.list.theme')->getPath('luxury_motors');
  $variables['success_icon'] = '/' . $path . '/images/icons/success-car.png';
}

/**
 * Implements hook_preprocess_HOOK() for checkout.
 */
function lm_booking_preprocess_lm_booking_checkout_form(array &$variables): void {
  $form = $variables['form'] ?? [];
  $variables['trip'] = $form['#trip'] ?? [];
  $variables['quote'] = $form['#quote'] ?? [];
  $variables['#attached']['library'][] = 'luxury_motors/checkout';
}

/**
 * Implements hook_preprocess_HOOK() for reservation lookup/manage.
 */
function lm_booking_preprocess_lm_booking_reservation_form(array &$variables): void {
  $form = $variables['form'] ?? [];
  $variables['guest'] = $form['#guest'] ?? [];
  $variables['trip'] = $form['#trip'] ?? [];
  $variables['quote'] = $form['#quote'] ?? [];
  $variables['reference'] = $form['#reference'] ?? '';
  $variables['status'] = $form['#status'] ?? '';
  $variables['status_label'] = $form['#status_label'] ?? '';
  $variables['cancellable'] = (bool) ($form['#cancellable'] ?? FALSE);
  $variables['fleet_url'] = $form['#fleet_url'] ?? '';
  $variables['disclaimer'] = $form['#disclaimer'] ?? '';
  $variables['#attached']['library'][] = 'luxury_motors/checkout';
}

/**
 * Implements hook_cron().
 */
function lm_booking_cron(): void {
  \Drupal::service('lm_booking.grace_period_processor')->process();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 */
function lm_booking_node_presave(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof \Drupal\node\NodeInterface || $entity->bundle() !== 'booking') {
    return;
  }
  if (!$entity->hasField('field_booking_status') || !$entity->hasField('field_booking_grace_cancel_sent')) {
    return;
  }
  if (\Drupal::service('lm_booking.grace_period_processor')->isAutoExpiring()) {
    return;
  }
  if ((string) $entity->get('field_booking_status')->value !== 'cancelled') {
    return;
  }
  $original = $entity->getOriginal();
  if ($original instanceof \Drupal\node\NodeInterface && $original->hasField('field_booking_status')) {
    if ((string) $original->get('field_booking_status')->value === 'cancelled') {
      return;
    }
  }
  elseif (!$entity->id()) {
    return;
  }
  if (!$entity->get('field_booking_grace_cancel_sent')->isEmpty()) {
    return;
  }
  $entity->set('field_booking_grace_cancel_sent', \Drupal::time()->getRequestTime());
}
