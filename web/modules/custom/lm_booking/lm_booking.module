<?php

/**
 * @file
 * Views integration and checkout theme hooks.
 */

declare(strict_types=1);

/**
 * Implements hook_views_data_alter().
 */
function lm_booking_views_data_alter(array &$data): void {
  $data['node_field_data']['lm_booking_available_window'] = [
    'title' => t('Available in rental window'),
    'help' => t('Hides vehicles that have a pending or confirmed booking overlapping pickup/return.'),
    'filter' => [
      'id' => 'lm_booking_available_window',
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function lm_booking_theme(): array {
  return [
    'lm_booking_checkout_form' => [
      'render element' => 'form',
    ],
    'lm_booking_confirmation' => [
      'variables' => [
        'reference' => '',
        'guest' => [],
        'trip' => [],
        'quote' => [],
        'fleet_url' => '',
        'manage_url' => '',
        'copy_icon' => '',
      ],
    ],
    'lm_booking_reservation_form' => [
      'render element' => 'form',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for checkout.
 */
function lm_booking_preprocess_lm_booking_checkout_form(array &$variables): void {
  $form = $variables['form'] ?? [];
  $variables['trip'] = $form['#trip'] ?? [];
  $variables['quote'] = $form['#quote'] ?? [];
  $variables['#attached']['library'][] = 'luxury_motors/checkout';
}

/**
 * Implements hook_preprocess_HOOK() for reservation lookup/manage.
 */
function lm_booking_preprocess_lm_booking_reservation_form(array &$variables): void {
  $form = $variables['form'] ?? [];
  $variables['guest'] = $form['#guest'] ?? [];
  $variables['trip'] = $form['#trip'] ?? [];
  $variables['quote'] = $form['#quote'] ?? [];
  $variables['reference'] = $form['#reference'] ?? '';
  $variables['status'] = $form['#status'] ?? '';
  $variables['status_label'] = $form['#status_label'] ?? '';
  $variables['cancellable'] = (bool) ($form['#cancellable'] ?? FALSE);
  $variables['fleet_url'] = $form['#fleet_url'] ?? '';
  $variables['disclaimer'] = $form['#disclaimer'] ?? '';
  $variables['#attached']['library'][] = 'luxury_motors/checkout';
}
