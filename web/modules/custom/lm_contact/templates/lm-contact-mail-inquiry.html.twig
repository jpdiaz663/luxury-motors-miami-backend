{#
/**
 * @file
 * Concierge inquiry email (guest acknowledgment or desk copy).
 */
#}
{% set is_desk = audience == 'desk' %}
{% set rosso = '#da291c' %}
{% set notte = '#181818' %}
{% set grafite = '#303030' %}
{% set velo = '#f7f7f7' %}
{% set fumo = '#8f8f8f' %}
{% set white = '#ffffff' %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ is_desk ? 'New vehicle requirement'|t : 'We received your requirement'|t }}</title>
</head>
<body style="margin:0;padding:0;background-color:{{ velo }};font-family:Inter,Helvetica Neue,Arial,sans-serif;color:{{ notte }};">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:{{ velo }};">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="max-width:600px;width:100%;background-color:{{ white }};">
          <tr>
            <td style="background-color:{{ notte }};padding:28px 32px;border-bottom:3px solid {{ rosso }};">
              <p style="margin:0 0 6px;font-size:11px;letter-spacing:0.09em;text-transform:uppercase;color:{{ fumo }};">{{ site_name }}</p>
              <h1 style="margin:0;font-size:22px;font-weight:500;color:{{ white }};line-height:1.3;">
                {% if is_desk %}
                  {{ 'New requirement on the desk'|t }}
                {% else %}
                  {{ 'We received your requirement'|t }}
                {% endif %}
              </h1>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 32px 8px;">
              {% if is_desk %}
                <p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:{{ grafite }};">{{ 'Reply to this message to reach the guest. The copy below is what they sent from the concierge form.'|t }}</p>
              {% else %}
                <p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:{{ grafite }};">{{ 'The Miami desk has your note. We will reply from this address if anything else is needed.'|t }}</p>
              {% endif %}
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 24px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:{{ velo }};">
                <tr>
                  <td style="padding:20px 24px;">
                    <p style="margin:0 0 12px;font-size:11px;letter-spacing:0.09em;text-transform:uppercase;color:{{ fumo }};">{{ is_desk ? 'Guest'|t : 'Your details'|t }}</p>
                    {% if name %}<p style="margin:0 0 6px;font-size:14px;color:{{ notte }};">{{ name }}</p>{% endif %}
                    {% if email %}<p style="margin:0 0 6px;font-size:14px;color:{{ grafite }};">{{ email }}</p>{% endif %}
                    {% if phone %}<p style="margin:0;font-size:14px;color:{{ grafite }};">{{ phone }}</p>{% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 32px;">
              <p style="margin:0 0 8px;font-size:11px;letter-spacing:0.09em;text-transform:uppercase;color:{{ fumo }};">{{ 'The requirement'|t }}</p>
              <p style="margin:0;font-size:14px;line-height:1.7;color:{{ notte }};white-space:pre-wrap;">{{ requirement }}</p>
            </td>
          </tr>
          <tr>
            <td style="background-color:{{ notte }};padding:20px 32px;">
              <p style="margin:0;font-size:11px;letter-spacing:0.06em;color:{{ fumo }};">
                {% if site_url %}
                  <a href="{{ site_url }}" style="color:{{ white }};text-decoration:none;">{{ site_name }}</a>
                {% else %}
                  {{ site_name }}
                {% endif %}
                — Miami
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
