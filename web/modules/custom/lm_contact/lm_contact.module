<?php

/**
 * @file
 * Theme hooks for the contact desk.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function lm_contact_theme(): array {
  return [
    'lm_contact' => [
      'variables' => [
        'kicker' => '',
        'heading' => '',
        'intro' => '',
        'form' => NULL,
        'channels' => [],
      ],
    ],
    'lm_contact_inquiry_form' => [
      'render element' => 'form',
    ],
    'lm_contact_mail_inquiry' => [
      'variables' => [
        'audience' => 'guest',
        'name' => '',
        'email' => '',
        'phone' => '',
        'requirement' => '',
        'site_name' => '',
        'site_url' => '',
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the contact desk.
 */
function lm_contact_preprocess_lm_contact(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/contact';
}
