<?php

/**
 * @file
 * Theme hooks and mail for the contact desk.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function lm_contact_theme(): array {
  return [
    'lm_contact' => [
      'variables' => [
        'kicker' => '',
        'heading' => '',
        'intro' => '',
        'form' => NULL,
        'channels' => [],
      ],
    ],
    'lm_contact_inquiry_form' => [
      'render element' => 'form',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the contact desk.
 */
function lm_contact_preprocess_lm_contact(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/contact';
}

/**
 * Implements hook_mail().
 */
function lm_contact_mail(string $key, array &$message, array $params): void {
  if ($key !== 'inquiry') {
    return;
  }

  $message['subject'] = (string) ($params['subject'] ?? t('New vehicle requirement'));
  $message['body'][] = (string) ($params['body'] ?? '');
  $reply = trim((string) ($params['reply_to'] ?? ''));
  if ($reply !== '') {
    $message['headers']['Reply-To'] = $reply;
  }
}
