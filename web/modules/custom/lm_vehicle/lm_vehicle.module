<?php

/**
 * @file
 * Theme hooks for vehicle detail sections.
 */

declare(strict_types=1);

use Drupal\lm_vehicle\FleetCatalog;

/**
 * Implements hook_views_data_alter().
 */
function lm_vehicle_views_data_alter(array &$data): void {
  $data['node_field_data']['lm_vehicle_one_per_category'] = [
    'title' => t('One vehicle per category'),
    'help' => t('Keeps a single fleet card for each vehicle category when no rental dates are in the request.'),
    'filter' => [
      'id' => 'lm_vehicle_one_per_category',
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function lm_vehicle_theme(): array {
  $vehicle = ['vehicle' => NULL];

  return [
    'lm_vehicle_hero' => [
      'variables' => $vehicle,
    ],
    'lm_vehicle_studio' => [
      'variables' => $vehicle,
    ],
    'lm_vehicle_story' => [
      'variables' => $vehicle,
    ],
    'lm_vehicle_specs' => [
      'variables' => $vehicle,
    ],
    'lm_vehicle_restrictions' => [
      'variables' => [
        'restrictions' => [],
        'vehicle' => NULL,
      ],
    ],
    'lm_vehicle_reserve' => [
      'variables' => $vehicle,
    ],
    'lm_vehicle_search' => [
      'variables' => [
        'form' => NULL,
        'background' => [],
      ],
    ],
    'lm_vehicle_search_form' => [
      'render element' => 'form',
    ],
    'lm_vehicle_refine_form' => [
      'render element' => 'form',
    ],
    'lm_vehicle_popular_collection' => [
      'variables' => [
        'general_title' => '',
        'heading' => '',
        'vehicles' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for the fleet Views page and home preview.
 */
function lm_vehicle_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || $view->id() !== 'vehicle_fleet') {
    return;
  }
  /** @var \Drupal\lm_vehicle\FleetCatalog $catalog */
  $catalog = \Drupal::service('lm_vehicle.fleet_catalog');
  $pills = $catalog->categoryPills();

  if ($view->current_display === 'block_1') {
    foreach ($pills as &$pill) {
      $pill['active'] = FALSE;
    }
    unset($pill);
    $variables['pills'] = $pills;
    $variables['fleet_url'] = FleetCatalog::PATH;
    return;
  }

  $variables['pills'] = $pills;
  $variables['window'] = $catalog->windowLabel();
  $variables['#attached']['library'][] = 'luxury_motors/vehicle_search';
}

/**
 * Implements hook_preprocess_HOOK() for the refine form.
 */
function lm_vehicle_preprocess_lm_vehicle_refine_form(array &$variables): void {
  $path = \Drupal::service('extension.list.theme')->getPath('luxury_motors');
  $variables['icon_path'] = '/' . $path . '/images/icons';
}

/**
 * Implements hook_preprocess_HOOK() for vehicle theme hooks.
 */
function lm_vehicle_preprocess_lm_vehicle_search(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/vehicle_search';
  $path = '/' . trim(\Drupal::request()->getPathInfo(), '/');
  $variables['is_fleet'] = $path === FleetCatalog::PATH || str_ends_with($path, FleetCatalog::PATH);
}

/**
 * Attaches the search library and whether the current query can go to checkout.
 */
function lm_vehicle_attach_trip_gate(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/vehicle_search';
  $variables['#attached']['drupalSettings']['lmVehicleSearch'] = array_merge(
    $variables['#attached']['drupalSettings']['lmVehicleSearch'] ?? [],
    \Drupal::service('lm_vehicle.fleet_catalog')->searchClientSettings(),
  );
}

/**
 * Implements hook_preprocess_HOOK() for vehicle theme hooks.
 */
function lm_vehicle_preprocess_lm_vehicle_hero(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/vehicle';
  lm_vehicle_attach_trip_gate($variables);
}

/**
 * Implements hook_preprocess_HOOK() for studio gallery.
 */
function lm_vehicle_preprocess_lm_vehicle_studio(array &$variables): void {
  $variables['#attached']['library'][] = 'luxury_motors/vehicle';
  lm_vehicle_attach_trip_gate($variables);
}

/**
 * Implements hook_preprocess_HOOK() for the reserve desk.
 */
function lm_vehicle_preprocess_lm_vehicle_reserve(array &$variables): void {
  lm_vehicle_attach_trip_gate($variables);
}
