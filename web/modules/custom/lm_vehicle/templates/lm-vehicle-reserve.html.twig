{#
/**
 * @file
 * Vehicle rates with checkout CTA (no mailto).
 */
#}
<section class="light" id="reserve">
  <div class="wrap">
    <p class="kicker">{{ 'Night desk'|t }}</p>
    <h2 class="title">{{ 'Reserve'|t }} {{ vehicle.title }}</h2>
    {% if vehicle.status %}
      <p class="muted track-micro">{{ vehicle.status }}</p>
    {% endif %}
    <div class="split">
      <div>
        <dl class="specs">
          {% if vehicle.daily %}
            <div class="spec">
              <dt>{{ 'Day'|t }}</dt>
              <dd>{{ vehicle.daily }}</dd>
            </div>
          {% endif %}
          {% if vehicle.weekly %}
            <div class="spec">
              <dt>{{ 'Week'|t }}</dt>
              <dd>{{ vehicle.weekly }}</dd>
            </div>
          {% endif %}
          {% if vehicle.monthly %}
            <div class="spec">
              <dt>{{ 'Month'|t }}</dt>
              <dd>{{ vehicle.monthly }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>
      {% if vehicle.checkout_url %}
        <p>
          <a class="btn btn--primary" href="{{ vehicle.checkout_url }}">{{ 'Continue to checkout'|t }}</a>
        </p>
      {% endif %}
    </div>
  </div>
</section>
