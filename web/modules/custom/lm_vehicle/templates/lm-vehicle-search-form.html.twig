{#
/**
 * @file
 * Fleet banner search. Markup matches the rental mockup hero form.
 */
#}
<form{{ create_attribute(form['#attributes']) }}>
  {{ form.form_build_id }}
  {{ form.form_token }}
  {{ form.form_id }}
  {{ form.category }}
  {{ form.brand }}
  {{ form.color }}
  {{ form.price }}
  {{ form.from }}
  {{ form.to }}

  {% if form['#on_fleet'] %}
    <div class="banner-desk">
      <p class="banner-desk-kicker">{{ 'Trip'|t }}</p>
      <p class="banner-desk-slip" data-banner-summary></p>
      <button type="button" class="banner-desk-toggle" data-banner-collapse aria-expanded="true" aria-controls="lm-banner-panel">
        <span data-banner-collapse-label>{{ 'Reduce'|t }}</span>
      </button>
    </div>
  {% endif %}

  <div class="banner-panel" id="lm-banner-panel" data-banner-panel>
  <p class="kicker">{{ 'Night desk · Brickell · MIA'|t }}</p>
  <h1 class="title">{{ 'The keys are already in Brickell'|t }}</h1>

  <div class="banner-places">
    <label class="banner-place" data-banner-place for="banner-from">
      <span class="banner-place-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="M8 1.5a4.5 4.5 0 00-4.5 4.5c0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5A4.5 4.5 0 008 1.5z"/><circle cx="8" cy="6" r="1.6"/></svg>
      </span>
      <span class="banner-place-copy">
        <span class="track-micro muted">{{ 'Pickup location'|t }}</span>
        {{ form.from_q }}
      </span>
    </label>
    <label class="banner-place" for="banner-to">
      <span class="banner-place-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="M2 14h12M8 2v9M5 8l3 3 3-3"/></svg>
      </span>
      <span class="banner-place-copy">
        <span class="track-micro muted">{{ 'Delivery location'|t }}</span>
        {{ form.to_q }}
      </span>
    </label>
  </div>

  <div class="banner-note" data-banner-note{% if not form['#show_place'] %} hidden{% endif %}>
    <label>
      <span class="track-micro muted">{{ 'Property name'|t }}</span>
      {{ form.place }}
    </label>
  </div>

  {% if form['#need_trip'] %}
    <p class="banner-dates-hint" role="status">
      <span class="banner-dates-hint__kicker">{{ 'Pickup location'|t }}</span>
      <strong>{{ 'Add a pickup location before reserving.'|t }}</strong>
      <span>{{ 'Dates are set. Checkout waits until you choose where to collect the car.'|t }}</span>
    </p>
  {% endif %}

  <p class="banner-dates-hint" data-banner-date-hint hidden role="status">
    <span class="banner-dates-hint__kicker">{{ 'Pickup'|t }}</span>
    <strong>{{ 'Your reservation must be made at least 24 hours before the pickup date.'|t }}</strong>
  </p>

  <div class="banner-window">
    <div class="banner-field">
      <label for="banner-pickup">{{ 'Pickup'|t }}</label>
      {{ form.pickup }}
    </div>
    <div class="banner-field">
      <label for="banner-ptime">{{ 'Time'|t }}</label>
      {{ form.ptime }}
    </div>
    <div class="banner-field">
      <label for="banner-return">{{ 'Return'|t }}</label>
      {{ form.return }}
    </div>
    <div class="banner-field">
      <label for="banner-rtime">{{ 'Time'|t }}</label>
      {{ form.rtime }}
    </div>

    <div class="banner-actions">
      <button type="submit" class="btn btn--primary banner-submit" data-banner-submit>
        <span class="banner-submit-icon banner-submit-icon--search" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
            <circle cx="7" cy="7" r="4.4"/>
            <path d="M10.4 10.4L14 14"/>
          </svg>
        </span>
        
        <span class="banner-submit-icon banner-submit-icon--spinner" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="8" cy="8" r="5.5" stroke-dasharray="22 12" stroke-linecap="round"/>
          </svg>
        </span>
        {{ 'Search'|t }}
      </button>
    </div>
  </div>
  </div>

</form>
