{#
/**
 * @file
 * Search hero: full-bleed background plus the banner form.
 *
 * On fleet the sticky section must be a sibling of the listing, not nested
 * in a short wrapper, or position:sticky has no room to travel.
 */
#}
{% if is_fleet %}
  <div class="hero-search-offset" aria-hidden="true"></div>
  <section class="hero hero--search hero--search-fleet" id="top" aria-label="{{ 'Search a car'|t }}">
    {{ form }}
  </section>
{% else %}
  <section class="hero hero--search" id="top" aria-label="{{ 'Search a car'|t }}">
    {{ form }}
  </section>
{% endif %}
