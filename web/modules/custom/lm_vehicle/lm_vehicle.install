      'field_transmission' => $item['transmission'],
      'field_fuel_type' => $item['fuel'],
      'field_drive_type' => $item['drive'],
      'field_engine' => $item['engine'],
      'field_seats' => $item['seats'],
      'field_doors' => $item['doors'],
      'field_color' => $item['color'],
      'field_daily_price' => $item['daily'],
      'field_weekly_price' => $item['weekly'],
      'field_monthly_price' => $item['monthly'],
      'field_currency' => 'USD',
    ]);
    $node->save();
    $created++;
  }

  return $created;
}

/**
 * Loads or creates a published taxonomy term.
 *
 * @param array<string, mixed> $fields
 *   Extra field values applied only when the term is created.
 */
function lm_vehicle_ensure_term(string $vid, string $name, array $fields = []): ?int {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->getStorage('taxonomy_vocabulary')->load($vid)) {
    return NULL;
  }

  $storage = $entity_type_manager->getStorage('taxonomy_term');
  $existing = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', $vid)
    ->condition('name', $name)
    ->range(0, 1)
    ->execute();
  if ($existing) {
    return (int) reset($existing);
  }

  $values = [
    'vid' => $vid,
    'name' => $name,
    'status' => 1,
  ];
  $term = Term::create($values);
  foreach ($fields as $field_name => $value) {
    if ($term->hasField($field_name)) {
      $term->set($field_name, $value);
    }
  }
  $term->save();

  return (int) $term->id();
}
