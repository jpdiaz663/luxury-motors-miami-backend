  foreach ($defaults as $item) {
    $title = $item['brand'] . ' - mock';
    $existing = $node_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'vehicle')
      ->condition('title', $title)
      ->range(0, 1)
      ->execute();
    if ($existing) {
      continue;
    }

    $brand_id = lm_vehicle_ensure_term('brand', $item['brand']);
    $category_id = lm_vehicle_ensure_term('vehicle_category', $item['category']['name'], [
      'field_category_code' => $item['category']['code'],
      'field_passengers' => $item['category']['passengers'],
    ]);
    if (!$brand_id || !$category_id) {
      continue;
    }

    $node = Node::create([
      'type' => 'vehicle',
      'title' => $title,
      'uid' => 1,
      'status' => 1,
      'field_brand' => $brand_id,
      'field_model' => $item['model'],
      'field_year' => $item['year'],
      'field_category' => $category_id,
      'field_vehicle_status' => 'available',
