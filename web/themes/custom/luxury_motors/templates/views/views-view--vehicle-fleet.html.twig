{#
/**
 * @file
 * Fleet listing under the search hero. Pills filter by category.
 */
#}
{%
  set classes = [
    'view-vehicle-fleet',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<section{{ attributes.addClass(classes, 'notte').setAttribute('id', 'fleet') }}>
  <div class="wrap">
    {{ title_prefix }}
    <p class="kicker">{{ 'Inventory on the floor tonight'|t }}</p>
    <h2 class="title">{{ 'Choose a car, not a package'|t }}</h2>
    {% if window %}
      <p class="muted track-ui fleet-window">{{ 'Available @window'|t({'@window': window}) }}</p>
    {% endif %}
    {{ title_suffix }}

    {% if pills %}
      <div class="pills" role="group" aria-label="{{ 'Fleet filters'|t }}">
        {% for pill in pills %}
          <a class="pill{{ pill.active ? ' is-active' }}" href="{{ pill.url }}">{{ pill.label }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% if refine %}
      {{ refine }}
    {% endif %}

    {{ header }}
    {{ attachment_before }}

    <div class="fleet-results" data-fleet-results>
      {% if rows %}
        <div class="fleet" data-fleet-grid>
          {{ rows }}
        </div>
      {% elseif empty %}
        <p class="muted track-ui" data-fleet-empty>{{ empty }}</p>
      {% endif %}

      <div class="fleet fleet--skeleton" data-fleet-skeleton hidden aria-hidden="true">
        {% for i in 1..6 %}
          <article class="card card--fleet card--skeleton" aria-hidden="true">
            <div class="card-photo skeleton-bone"></div>
            <div class="card-body">
              <span class="skeleton-bone skeleton-bone--title"></span>
              <span class="skeleton-bone skeleton-bone--meta"></span>
              <ul class="card-specs">
                <li class="skeleton-bone skeleton-bone--spec"></li>
                <li class="skeleton-bone skeleton-bone--spec"></li>
                <li class="skeleton-bone skeleton-bone--spec"></li>
              </ul>
            </div>
            <aside class="card-quote">
              <span class="skeleton-bone skeleton-bone--kicker"></span>
              <span class="skeleton-bone skeleton-bone--price"></span>
              <span class="skeleton-bone skeleton-bone--cta"></span>
            </aside>
          </article>
        {% endfor %}
      </div>
    </div>

    {{ pager }}
    {{ attachment_after }}
    {{ more }}
    {{ footer }}
  </div>
</section>
