{#
/**
 * @file
 * Chrome for Luxury Motors pages: overlay nav, content, footer.
 */
#}
<div{{ attributes }}>
  <header class="nav">
    {{ page.header }}
  </header>

  <main id="main-content" tabindex="-1" aria-label="{{ 'Main site content'|t }}"{% if node and node.bundle == 'vehicle' %} data-car-page{% endif %}>
    {{ page.content }}
  </main>

  <footer class="footer">
    {{ page.footer }}
  </footer>
</div>
