{#
/**
 * @file
 * Vehicle node is presented by OOP section blocks, not field formatters.
 */
#}
{# Full vehicle pages are composed by section blocks. Do not hide teasers. #}
{% if view_mode == 'full' %}
  <article{{ attributes.addClass('visually-hidden') }}>
    {{ title_prefix }}
    {{ title_suffix }}
  </article>
{% else %}
  <article{{ attributes }}>
    {{ title_prefix }}
    {{ title }}
    {{ title_suffix }}
    {{ content }}
  </article>
{% endif %}
