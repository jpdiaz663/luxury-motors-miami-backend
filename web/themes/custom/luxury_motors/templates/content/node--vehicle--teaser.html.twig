{#
/**
 * @file
 * Category vehicle card in the fleet listing.
 */
#}
<article{{ attributes.addClass('card', 'card--fleet').setAttribute('style', '--card-glow: ' ~ (card.glow|default(card.chip)|default('#8a8f94'))) }}>
  {{ title_prefix }}{{ title_suffix }}
  {% if card.image.url %}
    <a class="card-photo" href="{{ card.url }}">
      <img src="{{ card.image.url }}" alt="{{ card.image.alt }}" />
    </a>
  {% endif %}
  <div class="card-body">
    <h3 class="title">{{ card.display_title|default(card.title) }}</h3>
    {% if card.category_label %}
      <p class="card-category">{{ 'Category @label'|t({'@label': card.category_label}) }}</p>
    {% endif %}
    {% if card.specs %}
      <ul class="card-specs">
        {% for spec in card.specs %}
          <li class="card-spec">
            {% if icon_path %}
              <img class="card-spec-icon" src="{{ icon_path }}/spec-{{ spec.id }}.svg" alt="" width="16" height="16" />
            {% endif %}
            <span>{{ spec.label }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
  <aside class="card-quote">
    <p class="card-quote-kicker">{{ 'Total price'|t }}</p>
    {% if card.total_price %}
      <p class="card-quote-price">{{ card.total_price }}</p>
    {% endif %}
    {% if card.book_url %}
      <a class="btn btn--primary card-quote-cta" href="{{ card.book_url }}" data-lm-reserve data-lm-vehicle="{{ card.nid }}">{{ 'Reserve on Counter'|t }}</a>
    {% endif %}
  </aside>
</article>
